{
  "manifest_version": 3,
  "name": "balady unity | وحدة بلدي",
  "version": "2.2",
  "description": "إضافة لتنسيق وإرسال تفاصيل البلاغات عبر الواتساب مع التحديث الإلكتروني المباشر.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://tickets-daem.vercel.app/*",
    "*://daem.momah.gov.sa/*",
    "*://daem.momra.gov.sa/*",
    "*://daem.momrauh.gov.sa/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://daem.momah.gov.sa/*",
        "*://daem.momra.gov.sa/*",
        "*://daem.momrauh.gov.sa/*"
      ],
      "js": ["content.js"],
      "all_frames": true
    },
    {
      "matches": [
        "https://tickets-daem.vercel.app/*"
      ],
      "js": ["vercel-inject.js"],
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
